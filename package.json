{
  "name": "external-resources-monitoring-cli",
  "version": "0.1.0",
  "description": "A bounded CLI for observing anonymously accessible publication resources.",
  "type": "module",
  "bin": {
    "resource-monitor": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "csv-parse": "^6.1.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.9"
  }
}
